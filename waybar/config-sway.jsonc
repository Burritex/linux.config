{
    "include": [
        "~/.config/waybar/modules/clock.jsonc",
        "~/.config/waybar/modules/network.jsonc",
        "~/.config/waybar/modules/battery.jsonc",
        "~/.config/waybar/modules/bluetooth.jsonc",
        "~/.config/waybar/modules/pulseaudio.jsonc",
        "~/.config/waybar/modules/memory.jsonc",
        "~/.config/waybar/modules/pc_health.jsonc",

        "~/.config/waybar/modules/sway/workspaces.jsonc",
        "~/.config/waybar/modules/sway/window.jsonc",

        "~/.config/waybar/modules/custom/dividers.jsonc",
        "~/.config/waybar/modules/custom/wallpaper.jsonc",
        "~/.config/waybar/modules/custom/keyboard-layout.jsonc",
        "~/.config/waybar/modules/custom/light.jsonc"
    ],

    "modules-left": [
        "sway/workspaces",
        "custom/divider#1",
        "sway/window"
    ],
    "modules-center": [
        "custom/divider#1",
        "clock#date",
        "clock#time",
        "custom/divider#1"
    ],
    "modules-right": [
        "group/pc_health",
        "memory",
        "custom/divider#1",
        "bluetooth",
        "pulseaudio",
        "network"
    ],

    "layer": "top",
    "position": "top",
    "height": 23,
    "width": "auto",
    "margin": "0",
    "spacing":0,
    "all-outputs": true,
    "swap-icon-label": true
}
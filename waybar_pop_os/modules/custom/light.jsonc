{
    "custom/light":{
        "exec": "~/.config/waybar/scripts/brightness.sh",
        "interval": 10,
        "return-format": "json",
        "format": "󱄄",
        "on-click": "brightnessctl set +10%",
        "on-click-right": "brightnessctl set 10%-",
        "on-click-middle": "brightnessctl set 80%",
        "tooltip": true,
        "tooltip-format": "Controles:\nbotão esquerdo󰍽 -> aumenta o brilho\nbotão direito󰍽 -> diminui o brilho"
    }
}
